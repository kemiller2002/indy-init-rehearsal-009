      "title": "Pump P-101 trips (2026-11-04T02:24:03.986Z)",
      "problemStatement": "Pump P-101 tripped three times on the night shift of 3 November; each trip stopped line 2 for about 40 minutes.",
      "question": "Why does P-101 trip only on the night shift?"
    },
    {
      "sequence": 2,
      "actor": "causa-user",
      "at": "2026-11-04T02:24:07.4540000\u002B00:00",
      "type": "observation-recorded",
      "id": "55180c1f-c77b-4cdb-b302-b80f74540f16",
      "text": "Trip log shows overcurrent alarms at 01:12, 02:47 and 04:05.",
      "source": "SCADA trip log, line 2"
    },
    {
      "sequence": 3,
      "actor": "causa-user",
      "at": "2026-11-04T02:24:07.6930000\u002B00:00",
      "type": "observation-recorded",
      "id": "f2a84287-421b-4be5-92fe-083d7b0d49ff",
      "text": "Night-shift ambient temperature in the pump room fell to 4 \u00B0C.",
      "source": "Building management export"
    },
    {
      "sequence": 4,
      "actor": "causa-user",
      "at": "2026-11-04T02:24:08.1400000\u002B00:00",
      "type": "hypothesis-recorded",
      "id": "d41560c9-2ad6-41eb-ab46-ff681ccae8ff",
      "statement": "Cold, viscous lubricant raises motor load past the overcurrent setting.",
      "explanation": "Explains why trips cluster when the room is cold."
    },
    {
      "sequence": 5,
      "actor": "causa-user",
      "at": "2026-11-04T02:24:08.3540000\u002B00:00",
      "type": "hypothesis-recorded",
      "id": "49bdc1fe-6664-425e-b2e6-0248da06ab5d",
      "statement": "The overcurrent relay setting was lowered during the last maintenance.",
      "explanation": "Explains trips that began after maintenance."
    },
